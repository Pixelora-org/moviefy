# TMDB API Key (Required for movie data)
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini API Key (Required for AI-powered movie identification in meme reels and pick-for-me)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default Gemini model (default: gemini-2.0-flash)
# GEMINI_PICK_MODEL=gemini-2.0-flash

# YouTube Data API Key (Optional, for video reviews and meme reels)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Note: Use API key restrictions (IP or None), not HTTP referrers for server-side calls
YOUTUBE_API_KEY=your_youtube_api_key_here
# Alternative environment variable names also supported:
# YOUTUBE_DATA_API_KEY=your_youtube_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# OMDb API Key (Optional, for additional movie ratings)
# Get your API key from: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Clerk Authentication (Required for user features)
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Supabase (Required for user data and playlists)
# Get your keys from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
